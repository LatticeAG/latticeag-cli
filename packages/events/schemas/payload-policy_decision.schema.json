{
  "$ref": "#/definitions/Payload_policy_decision",
  "definitions": {
    "Payload_policy_decision": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "BLOCK",
            "CHALLENGE",
            "DEFER"
          ]
        },
        "matched_rule_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "challenge_id": {
          "type": "string"
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "classifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "classifier": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "intent": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "intent",
                    "confidence"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "intent",
              "confidence",
              "classifier",
              "alternatives"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "request_id",
        "decision",
        "reason",
        "duration_ms",
        "tool",
        "classifications"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
